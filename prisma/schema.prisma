generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HEAD // Head of Sales - sees everything across the team
  SALES_MANAGER // Individual sales rep reporting to the Head
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  CONTRACTOR
  CONSULTANT
  ARCHITECT
  DIRECT
  EVENT
}

enum EquipmentType {
  VRF
  ATOM
  FLOOR_STANDING
  ROOFTOP
  LARGE_DUCT
  MIXED_PRODUCT
}

enum DealStage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(SALES_MANAGER)
  title         String?
  phone         String?
  avatarColor   String    @default("#6366f1")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Manager relationship: a SALES_MANAGER reports to a HEAD
  managerId     String?
  manager       User?     @relation("TeamMembers", fields: [managerId], references: [id])
  directReports User[]    @relation("TeamMembers")

  accounts      Account[] @relation("AccountOwner")
  contacts      Contact[] @relation("ContactOwner")
  leads         Lead[]    @relation("LeadOwner")
  deals         Deal[]    @relation("DealOwner")
  activities    Activity[] @relation("ActivityOwner")
  notes         Note[]    @relation("NoteAuthor")
  targets       Target[]  @relation("SalesTarget")
  saleLineItems SaleLineItem[] @relation("SaleLineItemOwner")
}

model Target {
  id            String    @id @default(cuid())
  month         DateTime // first-of-month
  targetValue   Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String
  user          User      @relation("SalesTarget", fields: [userId], references: [id])

  @@unique([userId, month])
}

// One company-wide Naira/USD rate per month, used to compute landed price
// when the monthly Price Master upload doesn't supply its own.
model MonthlyExchangeRate {
  id            String    @id @default(cuid())
  month         DateTime  @unique
  rate          Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id          String    @id @default(cuid())
  name        String
  code        String?   @unique
  industry    String?
  website     String?
  phone       String?
  address     String?
  city        String?
  country     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId     String
  owner       User      @relation("AccountOwner", fields: [ownerId], references: [id])

  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]
}

model Contact {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  jobTitle    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId     String
  owner       User      @relation("ContactOwner", fields: [ownerId], references: [id])

  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])

  leads       Lead[]
  deals       Deal[]
  activities  Activity[]
  notes       Note[]

  // Set only for contacts brought in via the Leads sheet import, so
  // re-running the import can safely replace its own rows.
  importKey   String?   @unique
}

model Lead {
  id            String      @id @default(cuid())
  title         String
  company       String?
  status        LeadStatus  @default(NEW)
  // Probability this lead closes, as a percentage in steps of 10 (10-100).
  winProbability Int?
  source        LeadSource  @default(DIRECT)
  equipmentType EquipmentType?
  value         Float?
  email         String?
  phone         String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Set only for leads brought in via the Leads sheet import, so re-running
  // the import can safely replace its own rows instead of duplicating them.
  importKey     String?     @unique

  ownerId       String
  owner         User        @relation("LeadOwner", fields: [ownerId], references: [id])

  accountId     String?
  account       Account?    @relation(fields: [accountId], references: [id])

  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])

  convertedDealId String?   @unique
  convertedDeal   Deal?     @relation("LeadConversion", fields: [convertedDealId], references: [id])

  activities    Activity[]
  noteItems     Note[]
}

model Deal {
  id            String      @id @default(cuid())
  title         String
  stage         DealStage   @default(QUALIFICATION)
  value         Float       @default(0)
  probability   Int         @default(20)
  expectedCloseDate DateTime?
  closedAt      DateTime?
  lostReason    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ownerId       String
  owner         User        @relation("DealOwner", fields: [ownerId], references: [id])

  accountId     String?
  account       Account?    @relation(fields: [accountId], references: [id])

  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])

  sourceLead    Lead?       @relation("LeadConversion")

  // Set only for deals brought in via the historical sales-register import,
  // so re-running an import can't create duplicate deals.
  sourceTxnNo   Int?        @unique

  activities    Activity[]
  notes         Note[]
  lineItems     SaleLineItem[]
}

// One row per product line within a historical sale, so sales value can be
// broken down by product category and month/year - detail that collapses
// away once summed into Deal.value. Populated by the Sales Register import.
model SaleLineItem {
  id          String    @id @default(cuid())
  docDate     DateTime
  month       DateTime // first-of-month
  qty         Float
  value       Float

  // Stable idempotency key from the import (txn no + item code + line
  // index), so re-running the import can't create duplicate line items.
  sourceKey   String    @unique

  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  ownerId     String
  owner       User      @relation("SaleLineItemOwner", fields: [ownerId], references: [id])

  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])

  createdAt   DateTime  @default(now())
}

model Activity {
  id          String          @id @default(cuid())
  type        ActivityType
  subject     String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  status      ActivityStatus  @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  ownerId     String
  owner       User            @relation("ActivityOwner", fields: [ownerId], references: [id])

  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id])

  dealId      String?
  deal        Deal?           @relation(fields: [dealId], references: [id])

  contactId   String?
  contact     Contact?        @relation(fields: [contactId], references: [id])
}

model Note {
  id          String    @id @default(cuid())
  body        String
  createdAt   DateTime  @default(now())

  authorId    String
  author      User      @relation("NoteAuthor", fields: [authorId], references: [id])

  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])

  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])

  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
}

model Product {
  id            String      @id @default(cuid())
  code          String      @unique
  brand         String
  category      String
  subCategory   String
  model         String
  capacityKw    Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  pricelistEntries Pricelist[]
  saleLineItems    SaleLineItem[]
}

model Pricelist {
  id            String    @id @default(cuid())
  month         DateTime
  dealerPrice   Float
  landedPrice   Float?
  exchangeRate  Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  productId     String
  product       Product   @relation(fields: [productId], references: [id])

  @@unique([productId, month])
}
